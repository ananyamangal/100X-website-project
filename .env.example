# Copy this file to `.env` and fill in real values.

# --- MongoDB (required for catalogue / submissions storage) ----------------
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DBNAME?retryWrites=true&w=majority

# --- YouTube data for the homepage YT Shorts carousel (optional) -----------
YOUTUBE_CHANNEL_ID=
YOUTUBE_API_KEY=

# --- Email delivery for RFQ submissions (recommended) ----------------------
# Used by lib/email.ts -> /api/rfq-submit to forward submissions to admin.
# If either var is missing, the form still works — submissions fall back to
# MongoDB save + WhatsApp open. To enable email forwarding:
#   1. Create a Gmail App Password at https://myaccount.google.com/apppasswords
#      (requires 2FA on the Google account first).
#   2. Set EMAIL_USER to the Gmail address and EMAIL_APP_PASSWORD to the 16-char
#      app password (no spaces).
#   3. Optionally override EMAIL_TO to send to a different inbox than EMAIL_USER.
EMAIL_USER=100xcircle@gmail.com
EMAIL_APP_PASSWORD=
EMAIL_TO=

# --- Anthropic Claude API (REQUIRED for AI agents) ---------------------------
# Powers: Market Intelligence Director, Creative Director, Off-Page SEO Director
# Get key at: https://console.anthropic.com/settings/keys
# MUST be set in Vercel Environment Variables (Production + Preview + Development)
# Without this key all three Growth OS AI modules will return "ANTHROPIC_API_KEY not configured"
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Admin authentication -----------------------------------------------------
# Password for the legacy super-admin login at /admin
ADMIN_PASSWORD=your-admin-password-here

# --- Site URL (for SEO canonicals; defaults to https://www.100xcircle.com) -
NEXT_PUBLIC_SITE_URL=https://www.100xcircle.com

# --- Quote lead value (used by GTM dataLayer for conversion value) ---------
NEXT_PUBLIC_QUOTE_LEAD_VALUE_INR=75000
